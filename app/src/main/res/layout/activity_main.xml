<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:text="@string/main_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnLiveClass"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="@string/main_liveclass_button"
        app:cornerRadius="8dp" />

    <Button
        android:id="@+id/btnMiniLesson"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/main_minilesson_button"
        app:cornerRadius="8dp" />

    <Button
        android:id="@+id/btnPrepareLesson"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/main_preparelesson_button"
        app:cornerRadius="8dp" />

</LinearLayout>
